<view class="container">
  <!-- 品牌区 -->
  <view class="brand-area">
    <text class="brand-icon">🐾</text>
    <text class="brand-title">喵汪人格测试</text>
    <text class="brand-slogan">每一只毛孩子都有专属人格密码</text>
  </view>

  <!-- 物种选择区 -->
  <view class="species-area">
    <!-- 猫入口 -->
    <view class="species-card cat-card {{tapAnim === 'cat' ? 'tap-active' : ''}}" bindtap="onTapCat">
      <view class="card-img-area">
        <image class="card-img" src="/assets/images/cat-placeholder.jpg" mode="aspectFit" />
      </view>
      <view class="card-btn cat-btn">测猫咪人格</view>
      <text class="card-sub">解锁傲娇密码</text>
    </view>

    <!-- 狗入口 -->
    <view class="species-card dog-card {{tapAnim === 'dog' ? 'tap-active' : ''}}" bindtap="onTapDog">
      <view class="card-img-area">
        <image class="card-img" src="/assets/images/dog-placeholder.jpg" mode="aspectFit" />
      </view>
      <view class="card-btn dog-btn">测修勾人格</view>
      <text class="card-sub">解锁暖心密码</text>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disclaimer-text">🐾 本测试为趣味娱乐内容，PETI 为「喵汪人格测试」原创宠物人格体系，结果仅供参考，不构成任何专业建议。</text>
  </view>
</view>
