.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.theme-cat { background: #F8F7FF; }
.theme-dog { background: #FFFAF0; }

/* 进度条 */
.progress-wrap {
  margin-bottom: 24rpx;
}

.progress-num {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: #E8E8E8;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.3s linear;
}

.theme-cat .progress-fill { background: #6B5CE7; }
.theme-dog .progress-fill { background: #FF8C42; }

/* 题目区 */
.question-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  min-height: 100rpx;
}

.question-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C2C2C;
  text-align: center;
  line-height: 1.5;
}

/* 选项区 */
.options-area {
  margin-bottom: 16rpx;
}

.option-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.option-card:active { transform: scale(0.98); }

.option-selected {
  border-color: #6B5CE7;
  background: #F5F3FF;
}

.theme-dog .option-selected {
  border-color: #FF8C42;
  background: #FFF8F0;
}

.option-label {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #F0F0F0;
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-selected .option-label {
  background: #6B5CE7;
  color: #fff;
}

.theme-dog .option-selected .option-label { background: #FF8C42; }

.option-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.prev-btn {
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 24rpx;
}

.prev-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.pet-icon { font-size: 40rpx; }

/* 宠物吐槽弹窗 */
.feedback-toast {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 40rpx;
  animation: feedbackIn 0.3s ease;
  z-index: 100;
}

.feedback-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.feedback-text {
  font-size: 26rpx;
  color: #fff;
  white-space: nowrap;
}

@keyframes feedbackIn {
  from { opacity: 0; transform: translateX(-50%) translateY(20rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}
