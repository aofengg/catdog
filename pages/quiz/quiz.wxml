<view class="container {{petType === 'cat' ? 'theme-cat' : 'theme-dog'}}">
  <!-- 进度条 -->
  <view class="progress-wrap">
    <text class="progress-num">{{currentIndex + 1}}/{{totalQuestions}}</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{(currentIndex + 1) / totalQuestions * 100}}%"></view>
    </view>
  </view>

  <!-- 题目区 -->
  <view class="question-area">
    <text class="question-text">{{currentQuestion.scene}}</text>
  </view>

  <!-- 选项区 -->
  <view class="options-area">
    <view
      wx:for="{{currentQuestion.options}}"
      wx:key="index"
      class="option-card {{selectedIndex === index ? 'option-selected' : ''}}"
      bindtap="onSelectOption"
      data-index="{{index}}"
    >
      <text class="option-label">{{optionLabels[index]}}</text>
      <text class="option-text">{{item.text}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="prev-btn {{currentIndex === 0 ? 'prev-disabled' : ''}}" bindtap="onPrev">
      <text>← 上一题</text>
    </view>
    <text class="pet-icon">{{petType === 'cat' ? '🐱' : '🐶'}}</text>
  </view>
</view>
