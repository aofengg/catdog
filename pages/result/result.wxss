.container {
  min-height: 100vh;
  padding: 60rpx 40rpx 80rpx;
}

.theme-cat {
  background: linear-gradient(180deg, #F8F7FF 0%, #FFFFFF 50%);
}

.theme-dog {
  background: linear-gradient(180deg, #FFFAF0 0%, #FFFFFF 50%);
}

/* 结果头部 */
.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title-row {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.theme-cat .result-title {
  color: #6B5CE7;
}

.theme-dog .result-title {
  color: #FF8C42;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rare-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.rare-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.emotion-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F0F0F0;
}

.emotion-text {
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
}

/* 配图 + 照片并排 */
.photos-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.illust-cell {
  width: 310rpx;
  height: 310rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.illust-img {
  width: 100%;
  height: 100%;
}

.photo-cell {
  width: 310rpx;
  height: 310rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-img {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.placeholder-tip {
  font-size: 22rpx;
  color: #999;
}

/* 金句 */
.gold-quote {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.quote-text {
  font-size: 30rpx;
  color: #555;
  font-style: italic;
  line-height: 1.6;
}

/* 宠物评价气泡 */
.pet-comment-section {
  margin-bottom: 40rpx;
}

.pet-comment-bubble {
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  position: relative;
}

.theme-cat .pet-comment-bubble {
  border-color: #E8E0FF;
  background: #FDFCFF;
}

.theme-dog .pet-comment-bubble {
  border-color: #FFE8D4;
  background: #FFFCFA;
}

.pet-comment-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

/* 内容区段 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 16rpx;
  display: block;
}

.section-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
}

/* 主 CTA */
.cta-area {
  margin: 48rpx 0 32rpx;
}

.cta-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
}

.cta-btn:active {
  transform: scale(0.97);
}

.cta-cat {
  background: linear-gradient(135deg, #6B5CE7, #8B7CF7);
}

.cta-dog {
  background: linear-gradient(135deg, #FF8C42, #FFA366);
}

.cta-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 次级操作 */
.retest-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.sub-btn {
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 24rpx;
}

/* 广告区 */
.ad-area {
  margin: 32rpx 0;
}

/* 免责声明 */
.disclaimer {
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #BBBBBB;
  line-height: 1.8;
  display: block;
}
