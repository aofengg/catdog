.container {
  min-height: 100vh;
  padding: 60rpx 40rpx 80rpx;
}

.theme-cat {
  background: linear-gradient(180deg, #F8F7FF 0%, #FFFFFF 50%);
}

.theme-dog {
  background: linear-gradient(180deg, #FFFAF0 0%, #FFFFFF 50%);
}

/* 首屏视觉焦点：宠物头像 */
.hero-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.hero-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.theme-cat .hero-avatar {
  border-color: #E8E0FF;
  box-shadow: 0 8rpx 24rpx rgba(107, 92, 231, 0.12);
}

.theme-dog .hero-avatar {
  border-color: #FFE8D4;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.12);
}

/* 顶部认证标题 */
.result-header-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.header-text {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 4rpx;
}

.header-line {
  font-size: 26rpx;
  color: #D0D0D0;
  letter-spacing: 2rpx;
}

/* 结果头部 */
.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.title-row {
  margin-bottom: 12rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.theme-cat .result-title {
  color: #6B5CE7;
}

.theme-dog .result-title {
  color: #FF8C42;
}

/* 副标题 */
.subtitle-row {
  margin-bottom: 0;
}

.result-subtitle {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* 金句卡 */
.gold-quote-card {
  text-align: center;
  margin: 8rpx 0 12rpx;
  padding: 16rpx 32rpx;
}

.gold-quote-card .quote-main {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  line-height: 1.6;
}

.theme-cat .gold-quote-card .quote-main {
  color: #4A3728;
}

.theme-dog .gold-quote-card .quote-main {
  color: #5C3A1E;
}

/* 稀有度 + 标签 */
.badge-tags-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.rare-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.rare-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

/* 人设标签组 */
.tags-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 24rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.theme-cat .tag-item {
  color: #8B7CF7;
}

.theme-dog .tag-item {
  color: #FFA366;
}

.tag-sep {
  font-size: 22rpx;
  color: #D0D0D0;
  margin: 0 4rpx;
}

/* 身份小卡片 2x2 网格 */
.mini-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 0 8rpx;
}

.mini-card-item {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}

.theme-cat .mini-card-item {
  background: #F8F5FF;
}

.theme-dog .mini-card-item {
  background: #FFF8F2;
}

.mini-card-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.mini-card-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

/* 主 CTA */
.cta-area {
  margin: 32rpx 0 48rpx;
}

.cta-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
}

.cta-btn:active {
  transform: scale(0.97);
}

.cta-cat {
  background: linear-gradient(135deg, #6B5CE7, #8B7CF7);
}

.cta-dog {
  background: linear-gradient(135deg, #FF8C42, #FFA366);
}

.cta-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 无照片时 CTA 呼吸动画 */
.cta-pulse {
  animation: ctaPulse 2s ease-in-out infinite;
}

@keyframes ctaPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(107, 92, 231, 0.4); }
  50% { transform: scale(1.02); box-shadow: 0 8rpx 24rpx 0 rgba(107, 92, 231, 0.3); }
}

/* ========== 第二屏：详细模块 ========== */

/* 下滑引导提示 */
.scroll-hint {
  text-align: center;
  padding: 20rpx 0 32rpx;
  animation: scrollHintBounce 2s ease-in-out infinite;
}

.scroll-hint-text {
  font-size: 26rpx;
  color: #999;
  font-weight: bold;
}

.theme-cat .scroll-hint-text {
  color: #8B7CF7;
}

.theme-dog .scroll-hint-text {
  color: #FFA366;
}

@keyframes scrollHintBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8rpx); }
}

/* 锁定内容区域 */
.comment-title {
  margin-bottom: 0;
}

.locked-content-wrap {
  position: relative;
  overflow: hidden;
}

.locked-sections {
  transition: filter 0.5s ease;
}

.is-blurred {
  filter: blur(6px);
  pointer-events: none;
  user-select: none;
}

/* 渐变遮罩层 */
.locked-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 15%, rgba(255,255,255,0.55) 30%, rgba(255,255,255,0.5) 60%, rgba(255,255,255,0.45) 100%);
}

.unlock-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.unlock-btn {
  width: 70%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  animation: unlockPulse 2s ease-in-out infinite;
}

.unlock-btn:active {
  transform: scale(0.97);
}

.unlock-btn-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.unlock-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

@keyframes unlockPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.1); }
  50% { transform: scale(1.02); box-shadow: 0 8rpx 24rpx 0 rgba(0, 0, 0, 0.08); }
}

/* 内容区段通用 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 16rpx;
  display: block;
}

/* 模块1: 宠物评价气泡 */
.comment-section {
  margin-bottom: 40rpx;
}

.pet-comment-bubble {
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.theme-cat .pet-comment-bubble {
  border-color: #E8E0FF;
  background: #FDFCFF;
}

.theme-dog .pet-comment-bubble {
  border-color: #FFE8D4;
  background: #FFFCFA;
}

.pet-comment-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  font-weight: bold;
}

/* 模块2: 关系定义 */
.relationship-def-section .section-title {
  font-size: 28rpx;
  font-weight: normal;
  color: #999;
  margin-bottom: 12rpx;
}

.relationship-def-section .def-headline {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.6;
}

.theme-cat .relationship-def-section .def-headline {
  color: #6B5CE7;
}

.theme-dog .relationship-def-section .def-headline {
  color: #FF8C42;
}

.relationship-def-section .def-detail {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.def-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.def-card-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
}

.theme-cat .def-card-item {
  background: #F8F5FF;
}

.theme-dog .def-card-item {
  background: #FFF8F2;
}

.def-card-label {
  font-size: 24rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.def-card-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 关键词标签 */
.keywords-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.keyword-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  color: #888;
}

.theme-cat .keyword-tag {
  background: #F3F0FF;
  color: #8B7CF7;
}

.theme-dog .keyword-tag {
  background: #FFF5ED;
  color: #FFA366;
}

/* 模块3: 专属指数卡 2x2 */
.custom-indices-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.index-card-item {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.theme-cat .index-card-item {
  background: #F8F5FF;
}

.theme-dog .index-card-item {
  background: #FFF8F2;
}

.index-card-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.index-card-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.theme-cat .index-card-value {
  color: #6B5CE7;
}

.theme-dog .index-card-value {
  color: #FF8C42;
}

.index-card-comment {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

/* 模块4: 使用说明 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.theme-cat .tips-list {
  background: #FDFCFF;
  border: 2rpx solid #E8E0FF;
}

.theme-dog .tips-list {
  background: #FFFCFA;
  border: 2rpx solid #FFE8D4;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-bullet {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  line-height: 1.8;
}

.theme-cat .tip-bullet {
  color: #8B7CF7;
}

.theme-dog .tip-bullet {
  color: #FFA366;
}

.tip-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 次级操作 */
.retest-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.sub-btn {
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 24rpx;
}


/* 免责声明 */
.disclaimer {
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #BBBBBB;
  line-height: 1.8;
  display: block;
}
