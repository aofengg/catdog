.container {
  min-height: 100vh;
  padding: 60rpx 40rpx 80rpx;
}

.theme-cat {
  background: linear-gradient(180deg, #F8F7FF 0%, #FFFFFF 50%);
}

.theme-dog {
  background: linear-gradient(180deg, #FFFAF0 0%, #FFFFFF 50%);
}

/* 顶部认证标题 */
.result-header-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.header-text {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 4rpx;
}

.header-line {
  font-size: 26rpx;
  color: #D0D0D0;
  letter-spacing: 2rpx;
}

/* 结果头部 */
.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title-row {
  margin-bottom: 12rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #2C2C2C;
}

.theme-cat .result-title {
  color: #6B5CE7;
}

.theme-dog .result-title {
  color: #FF8C42;
}

/* 副标题 */
.subtitle-row {
  margin-bottom: 16rpx;
}

.result-subtitle {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rare-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.rare-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

/* 人设标签组 */
.tags-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tag-item {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.theme-cat .tag-item {
  color: #8B7CF7;
}

.theme-dog .tag-item {
  color: #FFA366;
}

.tag-sep {
  font-size: 22rpx;
  color: #D0D0D0;
  margin: 0 4rpx;
}

/* 配图 + 照片并排 */
.photos-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.illust-cell {
  width: 310rpx;
  height: 310rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.illust-img {
  width: 100%;
  height: 100%;
}

.photo-cell {
  width: 310rpx;
  height: 310rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-img {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.placeholder-tip {
  font-size: 22rpx;
  color: #999;
}

/* 双金句 */
.gold-quote {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 32rpx 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quote-main {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.theme-cat .quote-main {
  color: #4A3728;
}

.theme-dog .quote-main {
  color: #5C3A1E;
}

.quote-sub {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* 维度指数条 */
.indices-section {
  margin-bottom: 40rpx;
  padding: 24rpx 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.index-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.index-row:last-child {
  margin-bottom: 0;
}

.index-label {
  font-size: 24rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.index-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.index-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.index-value {
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 宠物评价气泡 */
.pet-comment-section {
  margin-bottom: 40rpx;
}

.pet-comment-bubble {
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  position: relative;
}

.theme-cat .pet-comment-bubble {
  border-color: #E8E0FF;
  background: #FDFCFF;
}

.theme-dog .pet-comment-bubble {
  border-color: #FFE8D4;
  background: #FFFCFA;
}

.pet-comment-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

/* 内容区段 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 16rpx;
  display: block;
}

.section-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
}

/* 关系总结 */
.section-summary {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  line-height: 1.7;
  display: block;
  margin-bottom: 12rpx;
}

/* 建议列表 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-bullet {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  line-height: 1.8;
}

.theme-cat .tip-bullet {
  color: #8B7CF7;
}

.theme-dog .tip-bullet {
  color: #FFA366;
}

.tip-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 关键词标签 */
.keywords-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.keyword-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  color: #888;
}

.theme-cat .keyword-tag {
  background: #F3F0FF;
  color: #8B7CF7;
}

.theme-dog .keyword-tag {
  background: #FFF5ED;
  color: #FFA366;
}

/* 主 CTA */
.cta-area {
  margin: 48rpx 0 32rpx;
}

.cta-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
}

.cta-btn:active {
  transform: scale(0.97);
}

.cta-cat {
  background: linear-gradient(135deg, #6B5CE7, #8B7CF7);
}

.cta-dog {
  background: linear-gradient(135deg, #FF8C42, #FFA366);
}

.cta-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 次级操作 */
.retest-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.sub-btn {
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 24rpx;
}

/* 广告区 */
.ad-area {
  margin: 32rpx 0;
}

/* 免责声明 */
.disclaimer {
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #BBBBBB;
  line-height: 1.8;
  display: block;
}
