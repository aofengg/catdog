<view class="container {{petType === 'cat' ? 'theme-cat' : 'theme-dog'}}">
  <!-- 离屏 Canvas（仅用于绘制导出） -->
  <canvas type="2d" id="posterCanvas" class="offscreen-canvas"></canvas>

  <!-- 海报预览区 -->
  <view class="preview-wrap">
    <image wx:if="{{posterImage}}" class="preview-img" src="{{posterImage}}" mode="widthFix" />
    <!-- 加载态 -->
    <view wx:if="{{isDrawing}}" class="canvas-loading">
      <text class="loading-text">海报生成中...</text>
    </view>
    <!-- 异常兜底 -->
    <view wx:if="{{drawError}}" class="canvas-error">
      <text class="error-text">海报生成失败，请重试</text>
      <view class="retry-btn" bindtap="onRetryDraw">
        <text>重新生成</text>
      </view>
    </view>
  </view>

  <!-- 分享配文（可见 + 点击复制） -->
  <view class="copy-card" bindtap="onCopyText">
    <text class="copy-content">{{circleText}}</text>
    <text class="copy-action">点击复制</text>
  </view>

  <!-- 操作区 -->
  <view class="action-area">
    <!-- 分享按钮（主引导） -->
    <view class="share-btn {{petType === 'cat' ? 'btn-cat' : 'btn-dog'}}" bindtap="onShareImage">
      <text class="share-text">分享给好友</text>
    </view>

    <!-- 保存按钮（次级） -->
    <view class="save-btn" bindtap="onSaveToAlbum">
      <text class="save-text">保存到相册</text>
    </view>
  </view>
</view>
