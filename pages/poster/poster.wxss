.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

.theme-cat {
  background: #F8F7FF;
}

.theme-dog {
  background: #FFFAF0;
}

/* 离屏 Canvas */
.offscreen-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750px;
  height: 2048px;
}

/* 海报预览 */
.preview-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  min-height: 400rpx;
}

.preview-img {
  width: 100%;
  display: block;
}

.canvas-loading,
.canvas-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  min-height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

/* 操作区 */
.action-area {
  padding: 16rpx 0;
}

.toggle-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.toggle-box {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #E0E0E0;
  position: relative;
  transition: background 0.3s;
  margin-right: 16rpx;
}

.toggle-on {
  background: #6B5CE7;
}

.theme-dog .toggle-on {
  background: #FF8C42;
}

.toggle-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.3s;
}

.toggle-on .toggle-dot {
  transform: translateX(36rpx);
}

.toggle-label {
  font-size: 28rpx;
  color: #666;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
}

.save-btn:active {
  transform: scale(0.97);
}

.btn-cat {
  background: linear-gradient(135deg, #6B5CE7, #8B7CF7);
}

.btn-dog {
  background: linear-gradient(135deg, #FF8C42, #FFA366);
}

.save-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.share-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
}

.share-btn:active {
  transform: scale(0.97);
}

.share-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
