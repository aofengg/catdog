.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

.theme-cat {
  background: #F8F7FF;
}

.theme-dog {
  background: #FFFAF0;
}

/* 离屏 Canvas */
.offscreen-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750px;
  height: 2048px;
}

/* 海报预览 */
.preview-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  min-height: 400rpx;
}

.preview-img {
  width: 100%;
  display: block;
}

.canvas-loading,
.canvas-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  min-height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

/* 操作区 */
.action-area {
  padding: 16rpx 0;
}

/* 分享配文卡片 */
.copy-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: #FAFAFA;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
}

.copy-card:active {
  background: #F0F0F0;
}

.copy-content {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.copy-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #DDDDDD;
  border-radius: 20rpx;
}

.theme-cat .copy-action {
  color: #6B5CE7;
  border-color: #D8D0F5;
}

.theme-dog .copy-action {
  color: #FF8C42;
  border-color: #FFD8B8;
}

.share-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
}

.btn-cat {
  background: linear-gradient(135deg, #6B5CE7, #8B7CF7);
}

.btn-dog {
  background: linear-gradient(135deg, #FF8C42, #FFA366);
}

.share-btn:active {
  transform: scale(0.97);
}

.share-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
}

.save-btn:active {
  transform: scale(0.97);
}

.save-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
